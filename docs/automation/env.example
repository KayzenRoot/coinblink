# CoinBlink environment template.
#
# Copy this file to `.env` at the repository root and fill in the values.
# `.env` is ignored by git on purpose: never commit real credentials.
#
#   cp docs/automation/env.example .env
#
# The same names are used by the GitHub Actions deploy workflow. In the
# repository, set them under Settings -> Secrets and variables -> Actions:
#   CLOUDFLARE_API_TOKEN   -> Secret   (required for the deploy workflow)
#   CLOUDFLARE_ACCOUNT_ID  -> Secret or Variable (required for the deploy workflow)
#   COINBLINK_CF_WORKER_NAME -> Variable (optional, defaults to coinblink-production)
#   COINBLINK_CF_WORKER_URL  -> Variable (optional, enables the post-deploy smoke test)

# --- Cloudflare deployment -------------------------------------------------
# Token with the "Edit Cloudflare Workers" permission for the target account.
CLOUDFLARE_API_TOKEN=
# Account id that owns the Worker.
CLOUDFLARE_ACCOUNT_ID=
# Worker name the deploy targets. A deploy never creates a new name by accident.
COINBLINK_CF_WORKER_NAME=coinblink-production
# Public URL of the deployed Worker, used only by the post-deploy smoke test.
COINBLINK_CF_WORKER_URL=
# Wrangler telemetry is disabled everywhere.
WRANGLER_SEND_METRICS=false

# --- Build metadata (optional) --------------------------------------------
# Origin of the deployed site. When set, the build emits canonical, hreflang
# alternates and og:url; when empty, no absolute URL is emitted at all.
PUBLIC_SITE_ORIGIN=
# Stamped into the build for traceability. The deploy workflow fills these.
PUBLIC_BUILD_SHA=
PUBLIC_BUILD_ENV=production

# --- Opt-in live readers (empty = off) -------------------------------------
# Attributed third-party market preview at /demo/markets/live.
PUBLIC_MARKET_LIVE=
# Attributed headlines from public RSS at /en/news/live.
PUBLIC_NEWS_LIVE=

# --- Local Docker ----------------------------------------------------------
# Port published by docker compose on 127.0.0.1.
COINBLINK_PORT=3000
# M07 X OAuth (Worker secrets; never commit real values)
X_CLIENT_ID=
X_CLIENT_SECRET=
# M05 owner auth (Worker secrets; never commit real values)
M05_OWNER_ENABLED=
M05_SESSION_SECRET=
M05_RP_ID=
M05_ORIGIN=
