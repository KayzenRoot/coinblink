{
  "name": "coinblink",
  "version": "0.1.0",
  "private": true,
  "description": "CoinBlink modular web application, development-first",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/assert-no-session-binding.mjs",
    "preview": "wrangler dev --config ./dist/server/wrangler.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check",
    "test:unit": "node --test",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.4",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@simplewebauthn/server": "14.0.3",
    "@types/node": "22.19.0",
    "astro": "7.3.8",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "wrangler": "4.149.0"
  }
}
