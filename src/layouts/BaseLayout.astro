---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "pt-BR";
}

const { title, description, lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070e0c" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "pt-BR" ? "Pular para o conteúdo" : "Skip to content"}</a>
    <slot />
  </body>
</html>
