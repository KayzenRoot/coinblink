---
/**
 * CB-M01-WO-001: original, local-only illustrative editorial thumbnails.
 * Decorative demos, NOT article photographs, asset logos, or evidence of live news.
 * Source: this Astro SVG component. No external imagery, scripts or network requests.
 */
interface Props {
  variant: "bitcoin" | "ethereum" | "policy" | "ecosystem";
}
const { variant } = Astro.props;
---
<svg class="editorial-artwork" viewBox="0 0 80 110" preserveAspectRatio="xMidYMid slice" focusable="false" aria-hidden="true">
  {variant === "bitcoin" && (
    <>
      <defs>
        <radialGradient id="editorial-btc-sky" cx="53%" cy="43%" r="65%">
          <stop offset="0%" stop-color="#986924" />
          <stop offset="60%" stop-color="#271b10" />
          <stop offset="100%" stop-color="#09120e" />
        </radialGradient>
        <linearGradient id="editorial-btc-gold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fff5bb" />
          <stop offset="35%" stop-color="#e6b84c" />
          <stop offset="70%" stop-color="#9f5d17" />
          <stop offset="100%" stop-color="#f4c95c" />
        </linearGradient>
      </defs>
      <rect width="80" height="110" fill="url(#editorial-btc-sky)" />
      <path d="M-6 95 23 61 37 78 61 48 87 77v33H-6Z" fill="#101a14" />
      <path d="m-8 103 37-30 15 19 23-26 20 19v25H-8Z" fill="#07100c" />
      <circle cx="43" cy="44" r="32" fill="#15100a" stroke="#7b561e" stroke-width="7" />
      <circle cx="43" cy="44" r="29" fill="url(#editorial-btc-gold)" stroke="#ffecb3" stroke-width="1.5" />
      <circle cx="43" cy="44" r="24" fill="none" stroke="#704009" stroke-width="2" />
      <path d="M22 32c6-12 15-17 27-15" fill="none" stroke="#fff6d2" stroke-opacity=".74" stroke-width="2.5" stroke-linecap="round" />
      <text x="43" y="61" text-anchor="middle" font-size="43" font-family="Arial, sans-serif" font-weight="800" fill="#704009" stroke="#3d270b" stroke-width=".7">₿</text>
      <path d="M4 83 18 76 30 83 45 65 61 77 79 67" fill="none" stroke="#b7f45a" stroke-opacity=".55" stroke-width="1.7" />
      <path d="m-4 105 33-22 17 14 26-17 14 9" fill="none" stroke="#8dae61" stroke-opacity=".45" stroke-width="1.8" />
    </>
  )}
  {variant === "ethereum" && (
    <>
      <defs>
        <radialGradient id="editorial-eth-sky" cx="58%" cy="40%" r="75%">
          <stop offset="0%" stop-color="#617aaf" />
          <stop offset="48%" stop-color="#263a62" />
          <stop offset="100%" stop-color="#0a1428" />
        </radialGradient>
        <linearGradient id="editorial-eth-crystal" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fff" />
          <stop offset="52%" stop-color="#b8c4ea" />
          <stop offset="100%" stop-color="#697cae" />
        </linearGradient>
      </defs>
      <rect width="80" height="110" fill="url(#editorial-eth-sky)" />
      <path d="M-4 88 19 43 32 67 48 36 84 75v35H-4Z" fill="#182540" />
      <path d="m19 43-7 27 9-11 12 8m15-31-11 30 13-13 17 13" fill="#8ca6ce" opacity=".38" />
      <path d="M-4 101 22 71 42 86 65 61 84 74v36H-4Z" fill="#0b1930" />
      <path d="M40 8 17 51l23 15 23-15L40 8Z" fill="url(#editorial-eth-crystal)" stroke="#f5f8ff" stroke-width="1.3" />
      <path d="M40 8v58l23-15L40 8Z" fill="#798dc2" />
      <path d="m17 51 23 35 23-35-23 15-23-15Z" fill="#dce6ff" stroke="#b8c6e7" stroke-width="1" />
      <path d="m40 66 23-15-23 35V66Z" fill="#7a91bc" />
      <path d="M10 18 21 12m40 4 8-9m-2 72 11 3" stroke="#cddcfb" stroke-opacity=".55" stroke-width="1.3" />
      <path d="M0 106 27 90 44 98 63 82 80 92" stroke="#6bc2d1" stroke-opacity=".7" fill="none" stroke-width="1.5" />
    </>
  )}
  {variant === "policy" && (
    <>
      <defs>
        <linearGradient id="editorial-policy-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3d433c" />
          <stop offset="55%" stop-color="#70674c" />
          <stop offset="100%" stop-color="#181d17" />
        </linearGradient>
        <linearGradient id="editorial-policy-stone" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#e4d8ae" />
          <stop offset="100%" stop-color="#8c856c" />
        </linearGradient>
      </defs>
      <rect width="80" height="110" fill="url(#editorial-policy-sky)" />
      <circle cx="61" cy="22" r="24" fill="#d9bc77" opacity=".18" />
      <path d="M1 106 9 77 17 86 32 66 47 85 68 66 80 88v22H1Z" fill="#1a241e" opacity=".7" />
      <path d="M11 47 40 29 69 47v7H11Z" fill="url(#editorial-policy-stone)" stroke="#eee1bc" stroke-width="1.2" />
      <path d="M40 24v7m-5-7h10" stroke="#f3e9cb" stroke-width="2" />
      <rect x="14" y="53" width="52" height="6" rx="1" fill="#d0c4a2" />
      <rect x="17" y="60" width="9" height="31" fill="#d7d1b9" />
      <rect x="28" y="60" width="9" height="31" fill="#b5b5a2" />
      <rect x="40" y="60" width="9" height="31" fill="#d7d1b9" />
      <rect x="52" y="60" width="9" height="31" fill="#b5b5a2" />
      <path d="M13 91h54v6H13Zm-4 6h62v5H9Z" fill="url(#editorial-policy-stone)" />
      <path d="M6 105h68" stroke="#eadab9" stroke-opacity=".72" stroke-width="2" />
      <path d="M18 60v28m14-28v28m13-28v28m12-28v28" stroke="#555e56" stroke-opacity=".26" stroke-width="1.5" />
    </>
  )}
  {variant === "ecosystem" && (
    <>
      <defs>
        <radialGradient id="editorial-eco-sky" cx="56%" cy="48%" r="73%">
          <stop offset="0%" stop-color="#185b61" />
          <stop offset="54%" stop-color="#152b3b" />
          <stop offset="100%" stop-color="#090f21" />
        </radialGradient>
        <linearGradient id="editorial-eco-bands" x1="0" y1="0" x2="1" y2=".5">
          <stop offset="0%" stop-color="#78f9ca" />
          <stop offset="49%" stop-color="#a0cdfe" />
          <stop offset="100%" stop-color="#bb8aff" />
        </linearGradient>
      </defs>
      <rect width="80" height="110" fill="url(#editorial-eco-sky)" />
      <circle cx="60" cy="32" r="31" fill="none" stroke="#80eeda" stroke-opacity=".16" stroke-width="9" />
      <circle cx="60" cy="32" r="23" fill="none" stroke="#ac86ec" stroke-opacity=".34" stroke-width="1.5" />
      <path d="M0 92 25 69 39 82 65 59 82 74v36H0Z" fill="#0a2328" />
      <path d="M0 107 32 84 46 97 65 80 82 94v16H0Z" fill="#07151d" />
      <path d="M13 27h56L56 40H0l13-13Zm0 20h56L56 60H0l13-13Zm0 20h56L56 80H0l13-13Z" fill="url(#editorial-eco-bands)" opacity=".97" />
      <path d="M13 28h56m-56 20h56m-56 20h56" stroke="#e4fff7" stroke-opacity=".55" stroke-width="1.7" />
      <path d="M8 12 20 8m41 79 12-3M5 87l10-7" stroke="#9bf9dd" stroke-opacity=".65" stroke-width="1.5" />
    </>
  )}
</svg>
