---
import { newsCopy, localizeMockNews } from "./news-i18n.mjs";
import { NEWS_MOCK_POLICY } from "./news-workbench.mjs";
interface MockItem {
  slug: string;
  category: string;
  title: string;
  summary: string;
  body: string;
  demo: boolean;
  published: boolean;
  rights: string;
}
interface Props { locale?: "en" | "pt-br"; item: MockItem | null; }
const { locale = "en", item } = Astro.props;
const copy = newsCopy(locale);
const shown = item && item.demo === true && item.published === false
  && item.rights === "SYNTHETIC_NOT_LICENSED_NEWS" ? localizeMockNews(item, locale) : null;
const base = locale === "pt-br" ? "/pt-br/news" : "/en/news";
---
<main id="main" class="m02-article">
  <nav aria-label={locale === "pt-br" ? "Navegação" : "Navigation"}><a href={base}>← {copy.back}</a></nav>
  {shown ? (
    <article>
      <p class="m02-status">{copy.detailDisclaimer} · {copy[shown.category] ?? shown.category}</p>
      <h1>{shown.title}</h1>
      <p class="lead">{shown.summary}</p>
      <p>{shown.body}</p>
      <p class="m02-status">{NEWS_MOCK_POLICY}</p>
    </article>
  ) : (
    <section role="status">
      <h1>{copy.missingTitle}</h1>
      <p>{copy.missing}</p>
    </section>
  )}
</main>
<style>
  .m02-article{max-width:55rem;margin:0 auto;padding:clamp(1.5rem,5vw,4rem);min-height:60vh}
  .m02-article nav{margin-bottom:2.5rem}.m02-article a{color:#b8f34b}
  .m02-article h1{font-size:clamp(2rem,5vw,4rem);line-height:1.12}
  .m02-article p{line-height:1.8;color:#c1d3c5;font-size:1.1rem}
  .m02-article .lead{color:#e9f6eb;font-size:1.25rem}
  .m02-article .m02-status{color:#f5c981;font-size:.85rem;font-weight:700;letter-spacing:.05em}
</style>
