---
import { LIVE_NEWS_QUERY_MAX, LIVE_NEWS_SINCE_OPTIONS, LIVE_NEWS_SOURCES } from "./rss-sources.mjs";
import { readLiveNews } from "./live-news.mjs";
import { fillLiveNewsCopy, getLiveNewsCopy } from "./live-news-copy.mjs";
import {
  clusterLiveHeadlines, clustersForSource, coveragePublishers, searchCoverageClusters,
} from "./live-clusters.mjs";
import {
  LIVE_NEWS_ALL_SOURCES, clampLiveSearchQuery, clampLiveSince, clampLiveSource, withinLiveSince,
} from "./live-news-filter.mjs";
import { formatLiveAge } from "./live-time.mjs";
import ReaderLocaleSwitch from "./ReaderLocaleSwitch.astro";
import SavedSearches from "./SavedSearches.astro";
interface Props {
  snapshot: Awaited<ReturnType<typeof readLiveNews>>;
  locale?: "en" | "pt-br" | "es";
}
const { snapshot, locale = "en" } = Astro.props;
const copy = getLiveNewsCopy(locale);
const live = snapshot.status === "LIVE_HEADLINES";
const stamp = (iso: string | null) =>
  iso === null ? copy.undated : iso.slice(0, 16).replace("T", " ") + " UTC";
const nowMs = Date.now();
const source = clampLiveSource(Astro.url.searchParams.get("source") ?? LIVE_NEWS_ALL_SOURCES);
const sinceHours = clampLiveSince(Astro.url.searchParams.get("since") ?? "");
const query = clampLiveSearchQuery(Astro.url.searchParams.get("q") ?? "");
// The window narrows the pool before grouping; the publisher filter keeps the
// whole story, so a filtered view still shows every publisher that carried it.
const viewHref = (nextSource: string, nextSince: number) => {
  const params = new URLSearchParams();
  if (query !== "") params.set("q", query);
  if (nextSource !== LIVE_NEWS_ALL_SOURCES) params.set("source", nextSource);
  if (nextSince > 0) params.set("since", String(nextSince));
  const search = params.toString();
  return "/" + locale + "/news/coverage" + (search === "" ? "" : "?" + search);
};
const filtered = query !== "" || source !== LIVE_NEWS_ALL_SOURCES || sinceHours > 0;
const intro = fillLiveNewsCopy(copy.coverageIntro, { feeds: LIVE_NEWS_SOURCES.length });
const pool = live
  ? snapshot.items.filter((item: { publishedAt: string | null }) => withinLiveSince(item, sinceHours, nowMs))
  : Object.freeze([]);
const allClusters = live ? clusterLiveHeadlines(pool) : Object.freeze([]);
const matched = searchCoverageClusters(allClusters, query);
const clusters = source === LIVE_NEWS_ALL_SOURCES ? matched : clustersForSource(matched, source);
const publisherAge = (iso: string | null) => formatLiveAge(iso, nowMs, locale) ?? copy.undated;
const rows = clusters.map((cluster) => ({
  cluster,
  publishers: coveragePublishers(cluster),
  age: formatLiveAge(cluster.latestAt, nowMs, locale) ?? copy.undated,
}));
const meta = live
  ? fillLiveNewsCopy(copy.coverageMeta, {
    time: stamp(snapshot.collectedAt), count: rows.length, sources: snapshot.sourcesRead,
  })
  : "";
const unavailableBody = snapshot.status === "UNAVAILABLE"
  ? fillLiveNewsCopy(copy.unavailableBody, { reason: snapshot.reason })
  : "";
---
<main id="main" class="m03-coverage">
  <nav aria-label={copy.navigation}><a href={"/" + locale + "/news"}>{copy.back}</a></nav>
  <ReaderLocaleSwitch locale={locale} />
  <header>
    <p class="m03-coverage__tag">CB-M03 · LIVE RSS · KEYLESS · DEMO ONLY</p>
    <h1>{copy.coverageH1}</h1>
    <p>{intro}</p>
  </header>

  {snapshot.status === "DISABLED" && (
    <section class="m03-coverage__state" role="status" data-m03-coverage="disabled">
      <h2>{copy.disabledTitle}</h2>
      <p>{copy.disabledBody}</p>
      <p class="m03-coverage__note">{copy.disabledNote}</p>
    </section>
  )}

  {snapshot.status === "UNAVAILABLE" && (
    <section class="m03-coverage__state" role="status" data-m03-coverage="unavailable">
      <h2>{copy.unavailableTitle}</h2>
      <p>{unavailableBody}</p>
      <p class="m03-coverage__note">{copy.unavailableNote}</p>
    </section>
  )}

  {live && (
    <section class="m03-coverage__state" aria-labelledby="m03-coverage-stories" data-m03-coverage="live">
      <h2 id="m03-coverage-stories">{copy.topTitle}</h2>
      <p class="m03-coverage__meta" role="status" aria-live="polite">{meta}</p>
      <form class="m03-coverage__filters" method="get" action={"/" + locale + "/news/coverage"}
        role="search" aria-label={copy.coverageFilterTitle} data-m03-coverage-filter>
        <label>{copy.filterQueryLabel}
          <input type="search" name="q" maxlength={LIVE_NEWS_QUERY_MAX} value={query}
            placeholder={copy.filterQueryHint} autocomplete="off" data-m03-coverage-query />
        </label>
        <label>{copy.filterSourceLabel}
          <select name="source">
            <option value="all" selected={source === LIVE_NEWS_ALL_SOURCES}>{copy.filterAllSources}</option>
            {LIVE_NEWS_SOURCES.map((entry) => (
              <option value={entry.id} selected={source === entry.id}>{entry.name}</option>
            ))}
          </select>
        </label>
        <button type="submit">{copy.filterApply}</button>
        <a href={"/" + locale + "/news/coverage"}>{copy.filterReset}</a>
        {sinceHours > 0 && <input type="hidden" name="since" value={sinceHours} />}
      </form>
      <nav class="m03-coverage__since" aria-label={copy.sinceTitle} data-m03-coverage-since>
        <span>{copy.sinceTitle}:</span>
        <a href={viewHref(source, 0)} aria-current={sinceHours === 0 ? "true" : undefined}>{copy.sinceAny}</a>
        {LIVE_NEWS_SINCE_OPTIONS.map((hours) => (
          <a href={viewHref(source, hours)} aria-current={sinceHours === hours ? "true" : undefined}>
            {fillLiveNewsCopy(copy.sinceHours, { hours })}
          </a>
        ))}
      </nav>
      <p class="m03-coverage__note">{copy.coverageFilterNote}</p>
      <SavedSearches locale={locale} surface="coverage" query={query} source={source} since={sinceHours} />
      {rows.length === 0 && (
        <p class="m03-coverage__note" data-m03-coverage-empty>
          {filtered ? copy.coverageFilteredEmpty : copy.coverageEmpty}
        </p>
      )}
      <ol class="m03-coverage__list">
        {rows.map(({ cluster, publishers, age }) => (
          <li class="m03-coverage__item" data-m03-coverage-item={cluster.id}>
            <h3 class="m03-coverage__headline">
              <a href={cluster.members[0].link} lang={cluster.members[0].language ?? undefined} rel="noreferrer noopener external">
                {cluster.members[0].title}
              </a>
            </h3>
            <p class="m03-coverage__byline">
              <span>{fillLiveNewsCopy(copy.topPublishers, { count: cluster.coverage })}</span>
              <span aria-hidden="true"> · </span>
              <time datetime={cluster.latestAt ?? undefined}>{age}</time>
            </p>
            <ul class="m03-coverage__publishers">
              {publishers.map((member) => (
                <li>
                  <a href={member.link} rel="noreferrer noopener external">{member.sourceName}</a>
                  <time datetime={member.publishedAt ?? undefined}>{publisherAge(member.publishedAt)}</time>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>
  )}

  <p class="m03-coverage__note"><a href={"/" + locale + "/news/live"}>{copy.coverageLiveLink}</a></p>
  <p class="m03-coverage__note">{copy.rightsNote}</p>
  <p class="m03-coverage__note"><a href={"/" + locale + "/about"}>{copy.howItWorks}</a></p>
</main>
<style>
  .m03-coverage{max-width:64rem;margin:0 auto;padding:clamp(1.5rem,5vw,4rem);min-height:60vh;color:#e9f6eb}
  .m03-coverage a{color:#b8f34b}
  .m03-coverage h1{font-size:clamp(1.9rem,4vw,3rem);line-height:1.15;margin:.4rem 0 1rem}
  .m03-coverage p{line-height:1.75;color:#c1d3c5}
  .m03-coverage__tag{color:#f5c981;font-weight:700;letter-spacing:.04em;font-size:.82rem}
  .m03-coverage__state{margin:1.75rem 0;padding:1.25rem;border:1px solid #456e4e;border-radius:.8rem;background:#111c17}
  .m03-coverage__state h2{margin:.2rem 0 .8rem;font-size:1.4rem}
  .m03-coverage__meta{font-size:.9rem;color:#9fb6a5}
  .m03-coverage__filters{display:flex;flex-wrap:wrap;gap:.75rem;align-items:flex-end;margin:1rem 0 .5rem;padding:1rem;border:1px solid #2f4a38;border-radius:.6rem}
  .m03-coverage__filters label{display:grid;gap:.35rem;font-size:.85rem;color:#9fb6a5;font-weight:650}
  .m03-coverage__filters input,.m03-coverage__filters select{background:#0b1513;color:#e9f6eb;border:1px solid #456e4e;border-radius:.4rem;padding:.5rem .6rem;min-width:12rem}
  .m03-coverage__filters button{background:#b8f34b;color:#10170b;border:0;border-radius:.4rem;padding:.55rem .9rem;font-weight:750;cursor:pointer}
  .m03-coverage__since{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:.35rem 0 .5rem;font-size:.85rem;color:#9fb6a5}
  .m03-coverage__since a{padding:.22rem .55rem;border:1px solid #456e4e;border-radius:999px;text-decoration:none}
  .m03-coverage__since a[aria-current="true"]{border-color:#b8f34b;color:#b8f34b;font-weight:700}
  .m03-coverage__list{list-style:none;margin:1.25rem 0 0;padding:0;display:grid;gap:1.35rem}
  .m03-coverage__item{border-top:1px solid #2f4a38;padding-top:1rem}
  .m03-coverage__item:first-child{border-top:0;padding-top:0}
  .m03-coverage__headline{margin:0 0 .4rem;font-size:1.15rem;line-height:1.35}
  .m03-coverage__byline{margin:0;font-size:.82rem;color:#9fb6a5;letter-spacing:.02em}
  .m03-coverage__publishers{list-style:none;display:flex;flex-wrap:wrap;gap:.45rem;margin:.6rem 0 0;padding:0}
  .m03-coverage__publishers a{display:inline-block;padding:.25rem .6rem;border:1px solid #456e4e;border-radius:999px;font-size:.82rem;text-decoration:none}
  .m03-coverage__publishers a:hover{border-color:#b8f34b}
  .m03-coverage__publishers li{display:inline-flex;align-items:baseline}
  .m03-coverage__publishers time{margin-left:.35rem;font-size:.78rem;color:#9fb6a5}
  .m03-coverage__note{color:#9fb6a5;font-size:.92rem}
  .m03-coverage a:focus-visible{outline:3px solid #cbfa58;outline-offset:3px}
</style>
