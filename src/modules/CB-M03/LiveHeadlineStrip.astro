---
import { readLiveNews } from "./live-news.mjs";
import { fillLiveNewsCopy, getLiveNewsCopy } from "./live-news-copy.mjs";
interface Props {
  snapshot: Awaited<ReturnType<typeof readLiveNews>>;
  locale?: "en" | "pt-br" | "es";
}
const { snapshot, locale = "en" } = Astro.props;
const copy = getLiveNewsCopy(locale);
const live = snapshot.status === "LIVE_HEADLINES";
const newest = snapshot.status === "LIVE_HEADLINES" ? snapshot.items.slice(0, 3) : Object.freeze([]);
const all = live ? fillLiveNewsCopy(copy.stripAll, { count: snapshot.itemCount }) : "";
const stamp = (iso: string | null) =>
  iso === null ? copy.undated : iso.slice(0, 16).replace("T", " ") + " UTC";
---
{live && newest.length > 0 && (
  <section class="m03-strip" aria-labelledby="m03-strip-title" data-m03-live-strip>
    <h2 id="m03-strip-title">{copy.stripTitle}</h2>
    <p class="m03-strip__note">{copy.stripNote}</p>
    <ul class="m03-strip__list">
      {newest.map((item: { id: string; title: string; link: string; sourceId: string;
        sourceName: string; sourceHome: string; publishedAt: string | null }) => (
        <li data-m03-live-strip-item={item.sourceId}>
          <a class="m03-strip__headline" href={item.link} rel="noreferrer noopener external">{item.title}</a>
          <span class="m03-strip__byline">
            <a href={item.sourceHome} rel="noreferrer noopener external">{item.sourceName}</a>
            <span aria-hidden="true"> · </span>
            <time datetime={item.publishedAt ?? undefined}>{stamp(item.publishedAt)}</time>
          </span>
        </li>
      ))}
    </ul>
    <a class="m03-strip__all" href={"/" + locale + "/news/live"}>{all}</a>
  </section>
)}
<style>
  .m03-strip{margin:1.5rem 0;padding:1.1rem 1.25rem;border:1px solid #456e4e;border-radius:.8rem;background:#111c17}
  .m03-strip h2{margin:0 0 .3rem;font-size:1.15rem;letter-spacing:.02em;color:#b8f34b}
  .m03-strip__note{margin:0 0 .8rem;font-size:.82rem;color:#9fb6a5}
  .m03-strip__list{list-style:none;margin:0 0 .8rem;padding:0;display:grid;gap:.6rem}
  .m03-strip__list li{border-top:1px solid #24392c;padding-top:.6rem}
  .m03-strip__headline{display:block;color:#f5f8f5;font-weight:650;text-decoration:none;line-height:1.35}
  .m03-strip__headline:hover{text-decoration:underline}
  .m03-strip__byline{display:block;margin-top:.2rem;font-size:.78rem;color:#9fb6a5}
  .m03-strip__byline a{color:#b8f34b}
  .m03-strip__all{display:inline-block;font-size:.85rem;font-weight:700;color:#b8f34b}
  .m03-strip a:focus-visible{outline:3px solid #cbfa58;outline-offset:3px}
</style>
