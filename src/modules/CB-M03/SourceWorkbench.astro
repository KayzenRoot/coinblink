---
import { SOURCE_DEMO_POLICY, inspectSyntheticSource, listSyntheticSources } from "./source-lab.mjs";
import uiUrl from "./source-lab.client.js?url&no-inline";
import { inspectSyntheticProvenance, summarizeSyntheticProvenance } from "./source-investigation.mjs";
import { createMockSourceTransfer } from "./source-transfer.mjs";
import LocalJourneyNav from "../../components/LocalJourneyNav.astro";
const rows = listSyntheticSources().items;
const overview = summarizeSyntheticProvenance();
const entries = rows.map(row => ({ row, report: inspectSyntheticProvenance(row.id).report }));
---
<main id="main" class="m03" data-m03-root>
  <nav><a href="/en">← CoinBlink Home</a></nav>
  <LocalJourneyNav current="sources" />
  <header>
    <small>M03 · OFFLINE MOCK · NO INGESTION · NO PUBLICATION</small>
    <h1>Sources & provenance lab</h1>
    <p>Every entry is invented and belongs to <code>example.test</code>. No publisher was contacted and no rights were granted.</p>
    <p class="policy">{SOURCE_DEMO_POLICY}</p>
  </header>
  <section class="m03-evidence-summary" aria-labelledby="m03-evidence-title">
    <h2 id="m03-evidence-title">Source evidence readiness · DEMO</h2>
    <p><strong>{overview.total}</strong> fictional examples ·
      <strong>{overview.rightsDenied}</strong> denied for rights ·
      <strong>{overview.unavailable}</strong> unavailable ·
      <strong>{overview.captured}</strong> captured ·
      <strong>{overview.publiclyUsable}</strong> approved for public use.</p>
    <p>These are invented records, never validated against a real publisher or license.</p>
  </section>
  <div class="m03-filters">
    <label>Filter fictional sources
      <input type="search" data-m03-query maxlength="80" autocomplete="off" placeholder="Source label or status" />
    </label>
    <label>Inspection outcome
      <select data-m03-state-filter>
        <option value="all">All outcomes</option>
        <option value="DENIED_RIGHTS">Rights not cleared</option>
        <option value="UNAVAILABLE">Provider unavailable</option>
      </select>
    </label>
  </div>
  <p role="status" data-m03-count aria-live="polite">{rows.length} synthetic source examples</p>
  <div class="m03-grid">
    {entries.map(({ row, report }) => <article data-m03-entry data-m03-id={row.id} data-m03-license={row.licensing} data-m03-state={inspectSyntheticSource(row).state} data-m03-searchable={[row.label,row.originUrl,row.status].join(" ").toLowerCase()}>
      <small>MOCK · RIGHTS NOT CLEARED · NOT INGESTED</small>
      <h2>{row.label}</h2>
      <p><code>{row.originUrl}</code></p>
      <dl>
        <dt>License state</dt><dd>{row.licensing}</dd>
        <dt>Inspection result</dt><dd>{inspectSyntheticSource(row).state}</dd>
        <dt>Capture time</dt><dd>None. No capture occurred.</dd>
        <dt>Public reuse</dt><dd>DENIED</dd>
      </dl>
      <button type="button" data-m03-export
        data-m03-packet={JSON.stringify(createMockSourceTransfer(row))}>
        Download fictional source report · JSON
      </button>
      {report ? <details class="m03-report">
        <summary>Inspect fictional evidence for {row.label}</summary>
        <p>Safety outcome: {report.inspection}. Reuse remains BLOCKED.</p>
        <dl>
          {report.checks.map(check => <><dt data-m03-check-code={check.code} data-m03-check-state={check.state}>{check.label}</dt><dd>{check.state}</dd></>)}
          <dt>Required next step</dt><dd>{report.action}</dd>
        </dl>
      </details> : <p>Fictional evidence report unavailable · REUSE BLOCKED</p>}
    </article>)}
  </div>
  <p data-m03-empty hidden>No synthetic sources match. No external search was made.</p>
  <p data-m03-export-status role="status" aria-live="polite">
    Source reports are MOCK, NOT_CLEARED and for manual transfer only. No evidence was captured.
  </p>
  <section class="m03-comparison" aria-labelledby="m03-compare-title">
    <h2 id="m03-compare-title">Compare fictional evidence gaps</h2>
    <p>Compare two invented records only. This never proves rights or retrieves evidence.</p>
    <div class="m03-compare-controls">
      <label>First fictional source
        <select data-m03-left>
          <option value="">Choose first source</option>
          {rows.map(row => <option value={row.id}>{row.label}</option>)}
        </select>
      </label>
      <label>Second fictional source
        <select data-m03-right>
          <option value="">Choose second source</option>
          {rows.map(row => <option value={row.id}>{row.label}</option>)}
        </select>
      </label>
      <button type="button" data-m03-compare>Compare evidence gaps</button>
    </div>
    <p data-m03-comparison role="status" aria-live="polite">Select two different fictional sources. Public reuse remains denied.</p>
    <p data-m03-compare-details aria-live="polite" class="m03-check-differences" hidden></p>
  </section>
</main>
<script is:inline src={uiUrl}></script>
<style>
  .m03{padding:clamp(1.25rem,5vw,4rem);max-width:76rem;margin:0 auto;min-height:70vh}
  .m03 a{color:#b8f34b}.m03 header{max-width:64ch}.m03 h1{font-size:clamp(2rem,5vw,4rem)}
  .m03 small,.m03 .policy{color:#f5c981;font-weight:700}.m03 header p{color:#b5c9bd}
  .m03-filters{display:flex;flex-wrap:wrap;gap:1rem;margin:1.25rem 0}
  .m03-filters label{display:grid;flex:1 1 16rem;gap:.4rem;max-width:26rem}
  .m03 input,.m03 select{padding:.75rem;border:1px solid #719a79;border-radius:.5rem;background:#14251b;color:#fff}
  .m03 input:focus-visible,.m03 select:focus-visible,.m03 button:focus-visible,.m03 summary:focus-visible{outline:3px solid #cbfa58;outline-offset:3px}
  .m03-evidence-summary,.m03-comparison{background:#101e17;border:1px solid #456e4e;border-radius:.75rem;padding:1.25rem;margin:1.2rem 0}
  .m03-evidence-summary p,.m03-comparison p{color:#d5e4da}
  .m03-report{margin-top:1rem;padding-top:.75rem;border-top:1px solid #456e4e}
  .m03-report summary{color:#b8f34b;cursor:pointer;font-weight:650}
  .m03-compare-controls{display:flex;flex-wrap:wrap;gap:1rem;align-items:end}
  .m03-compare-controls label{display:grid;flex:1 1 13rem;gap:.4rem}
  .m03-check-differences{white-space:pre-line;overflow-wrap:anywhere;border-left:3px solid #b8f34b;padding:.8rem;background:#192b20}
  .m03-check-differences[hidden]{display:none}
  .m03-compare-controls button{min-height:2.75rem;padding:.7rem 1rem;border-radius:.5rem;background:#b8f34b;color:#102015;font-weight:700;border:0;cursor:pointer}
  .m03-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:1rem}
  .m03 article{border:1px solid #456e4e;border-radius:.75rem;padding:1.25rem;background:#101e17}
  .m03 article[hidden]{display:none}.m03 h2{font-size:1.2rem}.m03 code{overflow-wrap:anywhere}
  .m03 dt{color:#b3c4b8}.m03 dd{margin:0 0 .65rem;color:#f0e5bc}
</style>
