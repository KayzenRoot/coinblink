  .m05-draft-import input[type="file"] { cursor:pointer; }
  .m05-draft-import p { margin:0; color:#a1afa5; font-size:11px; line-height:1.5; }
  .m05-draft-import [data-m05-import-status]:not(:empty) { color:#b8f34b; font-weight:650; }
  .m05-draft-fields label { margin-top:6px; display:flex; align-items:baseline; flex-wrap:wrap; justify-content:space-between; gap:4px; color:#f2f5f1; font-size:12px; font-weight:650; }
  .m05-draft-fields label span { color:#a1afa5; font-weight:450; font-size:10px; }
  .m05-draft-fields input, .m05-draft-fields textarea { width:100%; min-width:0; border:1px solid #3a4d40; border-radius:6px; padding:11px 12px; background:#0a120e; color:#f2f5f1; font:inherit; font-size:13px; resize:vertical; line-height:1.5; }
  .m05-draft-fields input::placeholder, .m05-draft-fields textarea::placeholder { color:#8fa494; opacity:1; }
  .m05-draft-panel input:focus-visible, .m05-draft-panel textarea:focus-visible, .m05-draft-panel button:focus-visible { outline:3px solid #b8f34b; outline-offset:2px; }
  .m05-draft-actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px; margin-top:10px; }
  .m05-draft-actions button { min-height:44px; border:0; border-radius:6px; padding:10px 16px; color:#10200e; background:#b8f34b; font:inherit; font-size:12px; font-weight:800; cursor:pointer; }
  .m05-draft-actions button:disabled { opacity:.55; cursor:not-allowed; }
  .m05-draft-actions span { color:#a1afa5; font-size:11px; }
