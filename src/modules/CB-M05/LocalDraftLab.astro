---
import metricsScriptUrl from "./local-draft-metrics.mjs?url&no-inline";
import searchScriptUrl from "./local-draft-search.mjs?url&no-inline";
import editorialScriptUrl from "./local-editorial-checklist.mjs?url&no-inline";
import sourcesScriptUrl from "./local-source-notes.mjs?url&no-inline";
import auditScriptUrl from "./local-citation-audit.mjs?url&no-inline";
---
<section class="m05-draft-panel" aria-labelledby="m05-draft-lab-heading" data-m05-local-editor>
  <div class="m05-draft-intro">
    <div>
      <p class="m05-draft-eyebrow">LOCAL-ONLY EDITORIAL WORKSPACE</p>
      <h2 id="m05-draft-lab-heading">Write, preview and export a draft</h2>
      <p>Export a Markdown file to keep working later, then import it here to resume. Nothing is uploaded or stored by CoinBlink; this is a public demo without login, fact checks or publishing.</p>
    </div>
    <span class="m05-draft-badge">NO CLOUD SAVE</span>
  </div>
  <div class="m05-draft-layout">
    <div class="m05-draft-fields" role="group" aria-label="Local draft fields">
      <div class="m05-draft-import">
        <label for="m05-draft-import">Resume from a CoinBlink .md draft</label>
        <input id="m05-draft-import" data-m05-import type="file" accept=".md,text/markdown" aria-describedby="m05-import-help" />
        <p id="m05-import-help">Select a previously exported CoinBlink Markdown file. Read locally, never uploaded; invalid files do not replace your work.</p>
        <p data-m05-import-status role="status" aria-live="polite"></p>
      </div>
      <label for="m05-draft-title">Headline <span>8–140 characters</span></label>
      <input id="m05-draft-title" data-m05-draft-title maxlength="140" type="text" autocomplete="off" placeholder="A precise, verifiable headline" />
      <label for="m05-draft-author">Author credit <span>optional, not a login</span></label>
      <input id="m05-draft-author" data-m05-draft-author maxlength="80" type="text" autocomplete="off" placeholder="Editorial byline" />
      <label for="m05-draft-source">Original source URL <span>required HTTPS</span></label>
      <input id="m05-draft-source" data-m05-draft-source maxlength="500" type="url" autocomplete="off" spellcheck="false" placeholder="https://publisher.example/original-article" />
      <label for="m05-draft-summary">Summary <span>20–400 characters</span></label>
      <textarea id="m05-draft-summary" data-m05-draft-summary maxlength="400" rows="3" placeholder="What happened and what is independently verified?"></textarea>
      <label for="m05-draft-body">Article draft <span>40–12,000 characters</span></label>
      <textarea id="m05-draft-body" data-m05-draft-body maxlength="12000" rows="8" placeholder="Write your original text and identify which claims still require verification."></textarea>
      <div class="m05-draft-actions">
        <button type="button" data-m05-export disabled>Export Markdown (.md)</button>
        <span data-m05-draft-hint role="status" aria-live="polite"></span>
      </div>

    </div>
    <section class="m05-draft-preview" aria-labelledby="m05-draft-preview-heading">
      <p class="m05-draft-eyebrow">TEXT-ONLY PREVIEW · NEVER PUBLISHED</p>
      <h3 id="m05-draft-preview-heading" data-m05-preview-title>Untitled local draft</h3>
      <p class="m05-draft-byline" data-m05-preview-author>Unassigned author label</p>
      <div class="m05-draft-preview-text" data-m05-preview-summary>Summary preview</div>
      <div class="m05-draft-preview-body" data-m05-preview-body>Draft body preview</div>
      <div class="m05-draft-source"><strong>Source:</strong> <span data-m05-preview-source>No verified HTTPS source URL</span></div>
      <p class="m05-draft-feedback" data-m05-preview-status role="status" aria-live="polite">Complete the fields to enable local export.</p>
      <div class="m05-draft-metrics" data-m05-local-metrics aria-label="Local drafting indicators" aria-live="polite">
        <div><strong data-m05-metric-words>0</strong><span>Draft words</span></div>
        <div><strong data-m05-metric-characters>0</strong><span>Characters</span></div>
        <div><strong data-m05-metric-minutes>0</strong><span>Est. reading min</span></div>
      </div>
      <p class="m05-draft-metrics-note">Reading time is an estimate, not a fact-check, source verification, approval or publication.</p>
    </section>
  </div>
  <p class="m05-draft-notice"><strong>Not saved online:</strong> export to .md before closing or reloading, then import that file to resume. Export is not evidence of factual accuracy, content rights, approval or publication. Never enter passwords, API tokens, private keys or sensitive information.</p>
</section>
<section class="m05-local-search" data-m05-local-search aria-labelledby="m05-local-search-heading">
  <div class="m05-local-search-heading">
    <h3 id="m05-local-search-heading">Find and replace in this draft</h3>
    <span><strong data-m05-search-count>0</strong> matches</span>
  </div>
  <div class="m05-local-search-fields">
    <label for="m05-local-find">Find in article body
      <input id="m05-local-find" type="search" maxlength="100" data-m05-search-query autocomplete="off" placeholder="Exact text to find" />
    </label>
    <label for="m05-local-replace">Replace with
      <input id="m05-local-replace" type="text" maxlength="200" data-m05-search-replacement autocomplete="off" placeholder="Replacement text" />
    </label>
  </div>
  <label class="m05-local-search-case" for="m05-local-case">
    <input id="m05-local-case" type="checkbox" data-m05-search-case />
    Match uppercase and lowercase exactly
  </label>
  <div class="m05-local-search-actions">
    <button type="button" data-m05-search-next disabled>Find next</button>
    <button type="button" data-m05-replace-selected disabled>Replace selected</button>
    <button type="button" data-m05-replace-all disabled>Replace all</button>
  </div>
  <p class="m05-local-search-note">Only your current article body changes. Re-export the Markdown file to keep the edits. Search results do not verify facts, citations or rights.</p>
  <p class="m05-local-search-status" data-m05-search-status role="status" aria-live="polite"></p>
</section>
<script is:inline type="module" src="/m05-draft-preview.js"></script>
<script is:inline type="module" src={metricsScriptUrl}></script>
<section class="m05-editorial-panel" data-m05-editorial-checklist aria-labelledby="m05-editorial-heading">
  <div class="m05-editorial-heading">
    <div><p class="m05-editorial-eyebrow">LOCAL EDITORIAL REVIEW · MOCK</p>
      <h3 id="m05-editorial-heading">Draft preparation checklist</h3></div>
    <strong class="m05-editorial-score" data-m05-editorial-score aria-label="Completed preparation tasks">0 / 7</strong>
  </div>
  <p class="m05-editorial-intro">Check for missing draft fields and track three personal review steps. These checks are not fact verification, rights clearance, publication approval, or an owner sign-off.</p>
  <div class="m05-editorial-checks" role="group" aria-label="Manual editorial preparation tasks">
    <label><input type="checkbox" data-m05-editorial-fact-review /> I noted claims that still need independent fact checking</label>
    <label><input type="checkbox" data-m05-editorial-rights-review /> I noted reuse rights and attribution questions for review</label>
    <label><input type="checkbox" data-m05-editorial-owner-packet /> I prepared this draft for future owner review, not approval</label>
  </div>
  <h4 class="m05-editorial-findings-heading">Preparation status</h4>
  <ul class="m05-editorial-findings" data-m05-editorial-findings aria-label="Editorial preparation status">
    <li>Complete the draft to calculate a local preparation checklist.</li>
  </ul>
  <p class="m05-editorial-note" role="status" aria-live="polite" data-m05-editorial-note>Nothing is saved or verified online.</p>
</section>
<script is:inline type="module" src={searchScriptUrl}></script>
<section class="m05-sources-panel" data-m05-sources-panel aria-labelledby="m05-source-panel-title">
  <div class="m05-sources-heading">
    <div>
      <p class="m05-sources-eyebrow">SOURCE DESK · LOCAL-ONLY DEMO</p>
      <h3 id="m05-source-panel-title">Citations and reference notes</h3>
    </div>
    <strong class="m05-sources-count" data-m05-source-count aria-label="Number of local references">0 / 12</strong>
  </div>
  <p class="m05-sources-description">Add up to 12 HTTPS reference notes and insert matching footnote markers in the article. The notes are part of the article body, so they travel with your local .md export/import. No URLs are opened, checked or uploaded.</p>
  <div class="m05-sources-fields">
    <label for="m05-sources-title">Source name
      <input id="m05-sources-title" data-m05-source-label maxlength="90" type="text" autocomplete="off" placeholder="Publisher or report title" />
    </label>
    <label for="m05-sources-url">Source URL (HTTPS)
      <input id="m05-sources-url" data-m05-source-url maxlength="500" type="url" autocomplete="off" spellcheck="false" placeholder="https://publisher.example/report" />
    </label>
  </div>
  <button class="m05-sources-add" type="button" data-m05-source-add disabled>Add source note to draft</button>
  <h4 class="m05-sources-list-title">References in this draft</h4>
  <ol class="m05-sources-list" data-m05-source-list aria-label="Local source notes">
    <li>No extra references added yet.</li>
  </ol>
  <p class="m05-sources-caution">These are unverified reference notes, not evidence that a claim is true or that content reuse is licensed. Removing a source also removes its matching citation markers. Re-export the Markdown file to preserve edits.</p>
  <p class="m05-sources-status" data-m05-source-status role="status" aria-live="polite"></p>
</section>
<script is:inline type="module" src={editorialScriptUrl}></script>
<script is:inline type="module" src={sourcesScriptUrl}></script>
<section class="m05-audit-panel" data-m05-citation-audit aria-labelledby="m05-audit-title">
  <div class="m05-audit-header">
    <div>
      <p class="m05-audit-eyebrow">LOCAL SOURCE HYGIENE · HEURISTIC DEMO</p>
      <h3 id="m05-audit-title">Citation consistency and claims to review</h3>
    </div>
    <strong class="m05-audit-counter" data-m05-audit-count>0 review signal(s)</strong>
  </div>
  <p class="m05-audit-description">Highlights citation IDs without source notes, unused references, explicit TODO/source placeholders, and some numerical claims with no local citation marker. A marker is not evidence that any claim is correct.</p>
  <h4 class="m05-audit-list-title">Review signals</h4>
  <ul class="m05-audit-list" data-m05-audit-findings aria-label="Citation and editorial review signals">
    <li>Enter a draft to see structural review signals.</li>
  </ul>
  <p class="m05-audit-footnote" role="status" aria-live="polite" data-m05-audit-status>Local text scan only. No provider or source is accessed.</p>
</section>
<script is:inline type="module" src={auditScriptUrl}></script>

<style>
  .m05-draft-panel { border:1px solid #2a3d32; border-radius:10px; padding:clamp(17px,2.5vw,24px); background:linear-gradient(145deg,#111d17,#0b120f); color:#f2f5f1; }
  .m05-draft-intro { display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:22px; }
  .m05-draft-eyebrow { margin:0; color:#b8f34b; font-size:9px; font-weight:750; letter-spacing:.13em; }
  .m05-draft-intro h2 { margin:6px 0; font-size:20px; line-height:1.3; }
  .m05-draft-intro p:not(.m05-draft-eyebrow) { margin:0; color:#a1afa5; font-size:12px; max-width:75ch; line-height:1.55; }
  .m05-draft-badge { flex:0 0 auto; padding:6px 10px; color:#b8f34b; font-size:10px; font-weight:700; border:1px solid #39533b; border-radius:6px; }
  .m05-draft-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:22px; align-items:start; }
  .m05-draft-fields { display:grid; gap:8px; min-width:0; }
  .m05-draft-import { display:grid; gap:6px; border:1px solid #314535; border-radius:7px; background:#101a14; padding:13px; }
  .m05-draft-import label { margin-top:0; font-size:12px; }
  .m05-draft-import input[type="file"] { cursor:pointer; }
  .m05-draft-import p { margin:0; color:#a1afa5; font-size:11px; line-height:1.5; }
  .m05-draft-import [data-m05-import-status]:not(:empty) { color:#b8f34b; font-weight:650; }
  .m05-draft-fields label { margin-top:6px; display:flex; align-items:baseline; flex-wrap:wrap; justify-content:space-between; gap:4px; color:#f2f5f1; font-size:12px; font-weight:650; }
  .m05-draft-fields label span { color:#a1afa5; font-weight:450; font-size:10px; }
  .m05-draft-fields input, .m05-draft-fields textarea { width:100%; min-width:0; border:1px solid #3a4d40; border-radius:6px; padding:11px 12px; background:#0a120e; color:#f2f5f1; font:inherit; font-size:13px; resize:vertical; line-height:1.5; }
  .m05-draft-fields input::placeholder, .m05-draft-fields textarea::placeholder { color:#8fa494; opacity:1; }
  .m05-draft-panel input:focus-visible, .m05-draft-panel textarea:focus-visible, .m05-draft-panel button:focus-visible { outline:3px solid #b8f34b; outline-offset:2px; }
  .m05-draft-actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px; margin-top:10px; }
  .m05-draft-actions button { min-height:44px; border:0; border-radius:6px; padding:10px 16px; color:#10200e; background:#b8f34b; font:inherit; font-size:12px; font-weight:800; cursor:pointer; }
  .m05-draft-actions button:disabled { opacity:.55; cursor:not-allowed; }
  .m05-draft-actions span { color:#a1afa5; font-size:11px; }
  .m05-draft-preview { min-width:0; border:1px solid #304535; border-radius:8px; background:#0c1510; padding:clamp(15px,2vw,21px); overflow-wrap:anywhere; }
  .m05-draft-preview h3 { margin:12px 0 5px; font-size:clamp(19px,2vw,26px); line-height:1.25; }
  .m05-draft-byline { margin:0 0 20px; color:#a1afa5; font-size:11px; }
  .m05-draft-preview-text { min-height:60px; color:#d9e7d9; font-size:13px; font-weight:600; line-height:1.6; white-space:pre-wrap; overflow-wrap:anywhere; }
  .m05-draft-preview-body { min-height:140px; margin:18px 0; border-top:1px solid #2a3d32; padding-top:15px; color:#a1afa5; font-size:12px; line-height:1.8; white-space:pre-wrap; overflow-wrap:anywhere; }
  .m05-draft-source { border-top:1px solid #2a3d32; padding-top:13px; font-size:11px; color:#a1afa5; overflow-wrap:anywhere; }
  .m05-draft-source strong { color:#f2f5f1; }
  .m05-draft-feedback { margin:16px 0 0; padding:10px 12px; border:1px solid #39533b; border-radius:6px; color:#b8f34b; font-size:11px; line-height:1.5; }
  .m05-draft-notice { margin:20px 0 0; border-left:3px solid #ffd27d; padding:10px 14px; background:#202018; color:#d3c6a8; font-size:11px; line-height:1.6; }
  .m05-draft-notice strong { color:#ffd27d; }
  .m05-draft-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:7px; margin-top:12px; }
  .m05-draft-metrics>div { display:grid; gap:3px; padding:9px; border:1px solid #304535; border-radius:6px; background:#101c14; }
  .m05-draft-metrics strong { color:#b8f34b; font-size:18px; font-variant-numeric:tabular-nums; }
  .m05-draft-metrics span { color:#b8bfb7; font-size:10px; line-height:1.35; }
  .m05-draft-metrics-note { margin:9px 0 0; color:#a1afa5; font-size:10px; line-height:1.5; }
  .m05-local-search { margin-top:18px; border:1px solid #39533b; border-radius:9px; background:#0b150e; padding:clamp(13px,2vw,18px); }
  .m05-local-search-heading { display:flex; justify-content:space-between; gap:12px; align-items:center; flex-wrap:wrap; }
  .m05-local-search-heading h3 { margin:0; color:#f2f5f1; font-size:14px; line-height:1.5; }
  .m05-local-search-heading span { color:#b8f34b; font-size:11px; }
  .m05-local-search-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin-top:12px; }
  .m05-local-search-fields label { display:grid; gap:7px; margin:0; font-size:11px; }
  .m05-local-search-fields input { width:100%; min-width:0; border:1px solid #3a4d40; border-radius:6px; background:#0a120e; color:#f2f5f1; padding:10px 12px; font:inherit; font-size:13px; }
  .m05-local-search input:focus-visible, .m05-local-search button:focus-visible { outline:3px solid #b8f34b; outline-offset:2px; }
  .m05-local-search-case { display:flex !important; justify-content:flex-start !important; align-items:center !important; gap:9px !important; margin:13px 0 !important; color:#d9e7d9; font-size:11px; }
  .m05-local-search-case input { width:17px !important; height:17px; min-width:17px; accent-color:#b8f34b; }
  .m05-local-search-actions { display:flex; flex-wrap:wrap; gap:8px; }
  .m05-local-search-actions button { min-height:39px; padding:8px 11px; border:1px solid #51704e; border-radius:6px; color:#f2f5f1; background:#22372a; font:inherit; font-size:11px; font-weight:650; cursor:pointer; }
  .m05-local-search-actions button:disabled { opacity:.45; cursor:not-allowed; }
  .m05-local-search-note { margin:13px 0 4px; color:#a1afa5; font-size:10px; line-height:1.55; }
  .m05-local-search-status { min-height:1.5em; margin:5px 0 0; color:#b8f34b; font-size:11px; line-height:1.5; }
  @media(max-width:540px) { .m05-local-search-fields { grid-template-columns:minmax(0,1fr); } }
  .m05-editorial-panel { margin-top:16px; padding:clamp(14px,2vw,21px); border:1px solid #3c5a44; border-radius:9px; background:linear-gradient(135deg,#132319,#0a120e); color:#f2f5f1; }
  .m05-editorial-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; }
  .m05-editorial-heading h3 { margin:5px 0 0; font-size:16px; line-height:1.3; }
  .m05-editorial-eyebrow { margin:0; font-size:10px; color:#b8f34b; font-weight:700; letter-spacing:.1em; }
  .m05-editorial-score { padding:8px 12px; border:1px solid #45684d; border-radius:7px; font-variant-numeric:tabular-nums; color:#b8f34b; font-size:16px; }
  .m05-editorial-intro { max-width:85ch; font-size:11px; line-height:1.6; color:#becdc0; }
  .m05-editorial-checks { display:grid; gap:10px; padding:13px; border:1px solid #344939; border-radius:8px; background:#0a160d; }
  .m05-editorial-checks label { display:flex; align-items:flex-start; gap:10px; font-size:12px; line-height:1.6; cursor:pointer; }
  .m05-editorial-checks input { width:17px; height:17px; flex:none; margin-top:1px; accent-color:#b8f34b; }
  .m05-editorial-checks input:focus-visible { outline:3px solid #b8f34b; outline-offset:3px; }
  .m05-editorial-findings-heading { margin:17px 0 7px; font-size:12px; }
  .m05-editorial-findings { padding-left:19px; margin:0; display:grid; gap:6px; color:#cfdbd0; font-size:11px; line-height:1.6; }
  .m05-editorial-note { margin:13px 0 0; min-height:1.5em; color:#b8f34b; font-size:11px; line-height:1.5; }
  .m05-sources-panel { margin-top:16px; padding:clamp(14px,2vw,22px); border:1px solid #42674b; border-radius:9px; background:linear-gradient(135deg,#14241a,#0a140f); color:#f2f5f1; }
  .m05-sources-heading { display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between; }
  .m05-sources-eyebrow { margin:0; font-size:10px; font-weight:750; letter-spacing:.1em; color:#b8f34b; }
  .m05-sources-heading h3 { margin:5px 0 0; font-size:16px; }
  .m05-sources-count { padding:8px 12px; border:1px solid #45684d; border-radius:7px; font-variant-numeric:tabular-nums; color:#b8f34b; font-size:15px; }
  .m05-sources-description, .m05-sources-caution { max-width:86ch; color:#c0d1c2; font-size:11px; line-height:1.65; }
  .m05-sources-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin:16px 0 12px; }
  .m05-sources-fields label { display:grid; gap:7px; color:#f2f5f1; font-size:12px; font-weight:650; }
  .m05-sources-fields input { width:100%; min-width:0; padding:11px 12px; border:1px solid #3e5b45; border-radius:6px; background:#0a120e; color:#f2f5f1; font:inherit; font-size:13px; }
  .m05-sources-panel input:focus-visible, .m05-sources-panel button:focus-visible { outline:3px solid #b8f34b; outline-offset:3px; }
  .m05-sources-add, .m05-sources-list button { padding:9px 11px; min-height:39px; border:1px solid #527751; border-radius:6px; background:#243e29; color:#f4f8f3; cursor:pointer; font:inherit; font-size:11px; font-weight:650; }
  .m05-sources-add:disabled { opacity:.45; cursor:not-allowed; }
  .m05-sources-list-title { margin:20px 0 8px; font-size:12px; }
  .m05-sources-list { padding-left:19px; display:grid; gap:12px; }
  .m05-sources-list li { font-size:11px; line-height:1.6; overflow-wrap:anywhere; }
  .m05-sources-list li span { display:block; margin:0 0 7px; }
  .m05-sources-list button { margin:0 7px 5px 0; }
  .m05-sources-caution { margin:14px 0 0; }
  .m05-sources-status { margin:9px 0 0; min-height:1.5em; color:#b8f34b; font-size:11px; line-height:1.6; }
  @media(max-width:540px) { .m05-sources-fields { grid-template-columns:minmax(0,1fr); } }
  .m05-audit-panel { margin-top:16px; padding:clamp(14px,2vw,22px); border:1px solid #53694c; border-radius:9px; background:linear-gradient(135deg,#15241c,#0c1610); color:#f2f5f1; }
  .m05-audit-header { display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between; }
  .m05-audit-eyebrow { margin:0; font-size:10px; font-weight:750; letter-spacing:.1em; color:#b8f34b; }
  .m05-audit-header h3 { margin:5px 0 0; font-size:16px; line-height:1.4; }
  .m05-audit-counter { padding:8px 12px; border:1px solid #526e50; border-radius:7px; color:#b8f34b; font-size:12px; font-variant-numeric:tabular-nums; }
  .m05-audit-description, .m05-audit-footnote { max-width:87ch; margin:12px 0; color:#c0d1c2; font-size:11px; line-height:1.7; }
  .m05-audit-list-title { margin:16px 0 8px; font-size:12px; }
  .m05-audit-list { margin:0; padding-left:19px; display:grid; gap:8px; font-size:11px; color:#f1f4f0; line-height:1.65; overflow-wrap:anywhere; }
  .m05-audit-footnote { color:#b8f34b; }
