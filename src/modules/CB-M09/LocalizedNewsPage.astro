---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsWorkbench from "../CB-M02/NewsWorkbench.astro";
import NewsArticle from "../CB-M02/NewsArticle.astro";
import LiveHeadlineStrip from "../CB-M03/LiveHeadlineStrip.astro";
import PublishedArticles from "../CB-M05/PublishedArticles.astro";
import { listArticleCards } from "../CB-M05/p1-production/articles.mjs";
import SponsoredSlot from "../CB-M13/SponsoredSlot.astro";
import { readLiveNews } from "../CB-M03/live-news.mjs";
import { filterSnapshot, hiddenSourceIds } from "../CB-M03/source-policy.mjs";
import { runtimeBinding } from "../../lib/runtime-env";
import { resolveMockNews } from "../CB-M02/news-workbench.mjs";

interface Props { locale: "en" | "pt-br" | "es"; slug?: string; category?: string; }
const { locale, slug, category } = Astro.props;
const detail = slug === undefined ? null : resolveMockNews(slug);
// The strip is opt-in and off by default, so a disabled build performs no
// request even though the news index is the busiest surface in the section.
const liveSnapshot = detail === null
  ? filterSnapshot(
    await readLiveNews({ enabled: import.meta.env.PUBLIC_NEWS_LIVE }),
    await hiddenSourceIds({ db: runtimeBinding("CMS_DB") }),
  )
  : null;
const meta = {
  en: {
    lang: "en", listTitle: "CoinBlink · News discovery (DEMO)",
    listDescription: "Fictional news discovery plus attributed third-party headlines; no publication.",
    detailTitle: "CoinBlink · Fictional article (DEMO)",
    detailDescription: "Invented, unpublished educational example.",
  },
  "pt-br": {
    lang: "pt-BR", listTitle: "CoinBlink · Descoberta de notícias (DEMO)",
    listDescription: "Busca de notícias fictícias e manchetes de terceiros com atribuição; sem publicação.",
    detailTitle: "CoinBlink · Leitura fictícia (DEMO)",
    detailDescription: "Exemplo inventado e não publicado.",
  },
  es: {
    lang: "es", listTitle: "CoinBlink · Descubrimiento de noticias (DEMO)",
    listDescription: "Exploración de noticias ficticias y titulares de terceros con atribución; sin publicación.",
    detailTitle: "CoinBlink · Lectura ficticia (DEMO)",
    detailDescription: "Ejemplo educativo inventado y no publicado.",
  },
} as const;
const copy = meta[locale];
// The page title says DEMO only while nothing real is on it: a published
// article or a live collection makes it a news page, not a workbench.
const realArticles = detail !== null ? [] : await listArticleCards({ db: runtimeBinding("CMS_DB"), locale, limit: 1 });
const hasRealContent = realArticles.length > 0 || liveSnapshot?.status === "LIVE_HEADLINES";
const realMeta = {
  en: ["CoinBlink · News", "Attributed headlines from public feeds and articles published by CoinBlink."],
  "pt-br": ["CoinBlink · Notícias", "Manchetes atribuídas de feeds públicos e artigos publicados pelo CoinBlink."],
  es: ["CoinBlink · Noticias", "Titulares atribuidos de fuentes públicas y artículos publicados por CoinBlink."],
} as const;
const [realTitle, realDescription] = realMeta[locale];
const listTitle = hasRealContent ? realTitle : copy.listTitle;
const listDescription = hasRealContent ? realDescription : copy.listDescription;
---
<BaseLayout lang={copy.lang} title={detail ? copy.detailTitle : listTitle}
  description={detail ? copy.detailDescription : listDescription}>
  {detail
    ? <NewsArticle locale={locale} item={detail.item} />
    : (
      <>
        <SponsoredSlot slot="home" />
        <PublishedArticles locale={locale} />
        <NewsWorkbench locale={locale} category={category}>
          {liveSnapshot && <LiveHeadlineStrip slot="live" snapshot={liveSnapshot} locale={locale} />}
        </NewsWorkbench>
      </>
    )}
</BaseLayout>
