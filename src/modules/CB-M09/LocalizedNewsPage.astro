---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsWorkbench from "../CB-M02/NewsWorkbench.astro";
import NewsArticle from "../CB-M02/NewsArticle.astro";
import { resolveMockNews } from "../CB-M02/news-workbench.mjs";

interface Props { locale: "en" | "pt-br" | "es"; slug?: string; category?: string; }
const { locale, slug, category } = Astro.props;
const detail = slug === undefined ? null : resolveMockNews(slug);
const meta = {
  en: {
    lang: "en", listTitle: "CoinBlink · Fictional news (DEMO)",
    listDescription: "Offline fictional news discovery; no live news or publication.",
    detailTitle: "CoinBlink · Fictional article (DEMO)",
    detailDescription: "Invented, unpublished educational example.",
  },
  "pt-br": {
    lang: "pt-BR", listTitle: "CoinBlink · Notícias fictícias (DEMO)",
    listDescription: "Busca demonstrativa sem notícias reais ou publicação.",
    detailTitle: "CoinBlink · Leitura fictícia (DEMO)",
    detailDescription: "Exemplo inventado e não publicado.",
  },
  es: {
    lang: "es", listTitle: "CoinBlink · Noticias ficticias (DEMO)",
    listDescription: "Ejemplos educativos inventados. No hay noticias, precios reales ni publicación.",
    detailTitle: "CoinBlink · Lectura ficticia (DEMO)",
    detailDescription: "Ejemplo educativo inventado y no publicado.",
  },
} as const;
const copy = meta[locale];
---
<BaseLayout lang={copy.lang} title={detail ? copy.detailTitle : copy.listTitle}
  description={detail ? copy.detailDescription : copy.listDescription}>
  {detail ? <NewsArticle locale={locale} item={detail.item} /> : <NewsWorkbench locale={locale} category={category} />}
</BaseLayout>
