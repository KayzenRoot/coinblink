---
import {listLocalWatchlistEntries} from "./watchlist-model.mjs";
import cssUrl from "./watchlist-preview.css?url&no-inline";
import jsUrl from "./watchlist-preview.client.js?url&no-inline";
const entries=listLocalWatchlistEntries();
---
<main id="main" class="m16-lab" data-m16-root>
  <header class="m16-panel">
    <p class="m16-label">M16 · LOCAL SYNTHETIC · NOT ADMITTED · NO ACCOUNT · NO LIVE ALERTS</p>
    <h1>Local watchlist preview</h1>
    <p>Order a handful of fictional entries to see how a future watchlist could behave.
      Nothing is monitored, priced, delivered or stored.</p>
    <p class="m16-block">ALERTS DISABLED · This preview can never notify, email, push or trade.</p>
  </header>
  <section class="m16-panel" aria-labelledby="m16-catalog-title">
    <h2 id="m16-catalog-title">Fictional catalog</h2>
    <p class="m16-help">Add up to four entries, then order them. The order disappears on reset or reload
      and no Market, News or CMS record is read or changed.</p>
    <ul class="m16-catalog" aria-label="Four fictional watchlist entries">
      {entries.map(entry=>
        <li class="m16-catalog__item">
          <span>{entry.label}</span>
          <button type="button" data-m16-add={entry.id}>Add to watchlist</button>
        </li>
      )}
    </ul>
  </section>
  <section class="m16-panel" aria-labelledby="m16-order-title">
    <h2 id="m16-order-title">Session order</h2>
    <ol class="m16-order" data-m16-order aria-label="Fictional watchlist in session order"></ol>
    <p class="m16-empty" data-m16-empty>No fictional entry ordered yet.</p>
    <label class="m16-direction">
      <span>Practice direction (never delivered)</span>
      <select data-m16-direction>
        <option value="none">No direction</option>
        <option value="above">Notionally above a fictional level</option>
        <option value="below">Notionally below a fictional level</option>
      </select>
    </label>
    <p data-m16-progress>0 of 4 practice entries ordered in this session.</p>
    <p data-m16-verdict aria-live="polite" role="status">ALERTS DISABLED · NOT_CONFIGURED · Nothing is monitored or delivered.</p>
    <button type="button" data-m16-reset>Reset practice watchlist</button>
  </section>
  <p class="m16-footnote">There is no account, login, personal data, consent record, provider connection,
    live price, notification, email, push channel, alert rule or trading action. A real watchlist needs
    separate documented owner decisions, privacy and consent review, provider licensing and change controls.</p>
</main>
<script is:inline type="module" src={jsUrl}></script>
<link rel="stylesheet" href={cssUrl} />
