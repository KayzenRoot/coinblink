---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNotFoundCopy, localeFromPathname } from "../modules/CB-M09/not-found-copy.mjs";

export const prerender = false;
Astro.response.status = 404;

const locale = localeFromPathname(Astro.url.pathname);
const copy = getNotFoundCopy(locale);
const lang: "en" | "pt-BR" | "es" = copy.lang === "pt-BR" ? "pt-BR" : copy.lang === "es" ? "es" : "en";
---
<BaseLayout lang={lang} title={copy.pageTitle} description={copy.pageDescription}>
  <main class="not-found" id="main" data-m09-not-found={locale}>
    <p class="eyebrow">{copy.eyebrow}</p>
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>{copy.h1}</h1>
    <p class="body-copy">{copy.body}</p>
    <p><a class="button button--primary" href={"/" + locale}>{copy.home}</a></p>
    <p><a href={"/" + locale + "/news"}>{copy.news}</a></p>
  </main>
</BaseLayout>
