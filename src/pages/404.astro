---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;
Astro.response.status = 404;
---

<BaseLayout
  title="Page not found · CoinBlink"
  description="This path is not part of the CoinBlink M00 local preview."
>
  <main class="not-found" id="main">
    <p class="eyebrow">COINBLINK · LOCAL PREVIEW</p>
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>Page not found</h1>
    <p class="body-copy">This route is not available in the M00 foundation.</p>
    <a class="button button--primary" href="/en">Return to home</a>
  </main>
</BaseLayout>
