---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LiveNewsPanel from "../../../modules/CB-M03/LiveNewsPanel.astro";
import { readLiveNews } from "../../../modules/CB-M03/live-news.mjs";
export const prerender = false;
// Off unless the deployment enables it: PUBLIC_NEWS_LIVE is a variable, not a code path.
const snapshot = await readLiveNews({ enabled: import.meta.env.PUBLIC_NEWS_LIVE });
---
<BaseLayout
  lang="en"
  title="CoinBlink · Live headlines from public RSS (DEMO)"
  description="Keyless public RSS headlines with attribution, shown as a demo and disabled by default."
>
  <LiveNewsPanel snapshot={snapshot} />
</BaseLayout>
