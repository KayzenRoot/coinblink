---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CoveragePage from "../../../modules/CB-M03/CoveragePage.astro";
import { readLiveNews } from "../../../modules/CB-M03/live-news.mjs";
import { getLiveNewsCopy } from "../../../modules/CB-M03/live-news-copy.mjs";
export const prerender = false;
const copy = getLiveNewsCopy("pt-br");
// Off unless the deployment enables it: PUBLIC_NEWS_LIVE is a variable, not a code path.
const snapshot = await readLiveNews({ enabled: import.meta.env.PUBLIC_NEWS_LIVE });
---
<BaseLayout lang="pt-BR" title={copy.coveragePageTitle} description={copy.coveragePageDescription}>
  <CoveragePage snapshot={snapshot} locale="pt-br" />
</BaseLayout>
