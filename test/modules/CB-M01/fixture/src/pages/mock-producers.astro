// Synthetic-only. Real article/market/source contents must never reach the Home.
const producerFeeds = {
  news: { contractVersion: "0.1-draft", mode: "MOCK",
    items: [{ id: "news-fiction-1", demo: true,
      headline: "PRIVATE_FIXTURE_NEVER_RENDER_THIS" }] },
  sources: { contractVersion: "0.1-draft", mode: "MOCK",
    items: [{ id: "source-fiction-1", demo: true,
      url: "https://fake-source.example.test/not-licensed" }] },
  markets: { contractVersion: "0.1-draft", mode: "MOCK",
